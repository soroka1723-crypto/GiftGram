<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Светлая тема (переопределяется в values-night) -->
    <style name="Theme.GiftGram" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/gg_accent</item>
        <item name="colorPrimaryVariant">@color/gg_accent_dark</item>
        <item name="colorOnPrimary">@color/gg_white</item>
        <item name="colorSecondary">@color/gg_cyan</item>
        <item name="colorSecondaryVariant">@color/gg_cyan</item>
        <item name="colorOnSecondary">@color/gg_white</item>
        <item name="android:colorBackground">@color/gg_bg</item>
        <item name="colorSurface">@color/gg_surface</item>
        <item name="colorOnSurface">@color/gg_text</item>
        <item name="colorOnBackground">@color/gg_text</item>
        <item name="android:textColorPrimary">@color/gg_text</item>
        <item name="android:textColorSecondary">@color/gg_muted</item>
        <item name="android:statusBarColor">@color/gg_bg</item>
        <item name="android:navigationBarColor">@color/gg_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/gg_bg</item>
        <item name="bottomSheetDialogTheme">@style/Theme.GiftGram.BottomSheet</item>
    </style>

    <!-- Сплэш всегда тёмный: сначала фон, затем он же как window background -->
    <style name="Theme.GiftGram.Splash" parent="Theme.GiftGram">
        <item name="android:windowBackground">@drawable/bg_splash</item>
        <item name="android:statusBarColor">#04050A</item>
        <item name="android:navigationBarColor">#04050A</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.GiftGram.BottomSheet" parent="Theme.MaterialComponents.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/GiftGram.BottomSheet.Modal</item>
    </style>

    <style name="GiftGram.BottomSheet.Modal" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="backgroundTint">@color/gg_bg2</item>
        <item name="shapeAppearanceOverlay">@style/GiftGram.SheetShape</item>
    </style>

    <style name="GiftGram.SheetShape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">26dp</item>
        <item name="cornerSizeTopRight">26dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="GiftGram.SheetRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:paddingTop">13dp</item>
        <item name="android:paddingBottom">13dp</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="GiftGram.SheetRowTitle" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/gg_text</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="GiftGram.SheetRowSub" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/gg_muted</item>
        <item name="android:textSize">12sp</item>
    </style>

</resources>
